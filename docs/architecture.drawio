  <diagram id="database-design" name="Database design">
    <mxGraphModel dx="1600" dy="1200" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1760" pageHeight="1420" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="v1" value="Sportscut — database design" style="text;html=1;align=left;verticalAlign=middle;fontSize=20;fontStyle=1;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="60" y="20" width="700" height="30" as="geometry" />
        </mxCell>
        <mxCell id="v2" value="Firestore, native mode. Two owning collections at top level; everything about a job&#10;lives in its subcollections. No relational joins — every read is a direct lookup&#10;or a declared index." style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#7A7A7A;" vertex="1" parent="1">
          <mxGeometry x="60" y="48" width="900" height="30" as="geometry" />
        </mxCell>
        <mxCell id="v3" value="jobs/{jobId}" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#3C4A5C;strokeColor=#3C4A5C;fontColor=#FFFFFF;fontSize=12;fontStyle=1;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="60" y="110" width="380" height="26" as="geometry" />
        </mxCell>
        <mxCell id="v4" value="PK jobId            string&#10;   ownerUid         string   provenance, not a gate&#10;   title            string&#10;   sport            string   handball | equestrian&#10;   status           string   uploaded|analyzing|analyzed|&#10;                             clips_ready|ready|needs_attention|&#10;                             failed|cancelled|cancelling&#10;   stage            string   ingest..captions|complete&#10;   progress         int      0-100, monotonic non-decreasing&#10;   metadataLanguage string   fixed at registration&#10;   source.gcsUri    string&#10;   source.bytes     int&#10;   source.originalName string&#10;   media.durationSec, .width, .height, .fps,&#10;        .videoCodec, .audioCodec, .segmentCount&#10;   playback.hlsUrl, .posterUrl, .renditions,&#10;        .segmentSeconds, .readyAt&#10;   teams.home, .away        consensus, handball only&#10;   counts.moments, .clips&#10;   cancelRequested  bool&#10;   error            string | null&#10;   createdAt, updatedAt     timestamp" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4A4A4A;verticalAlign=top;align=left;fontSize=11;spacing=4;fontFamily=Courier New;" vertex="1" parent="1">
          <mxGeometry x="60" y="136" width="380" height="406" as="geometry" />
        </mxCell>
        <mxCell id="v5" value="jobs/{jobId}/moments/{momentId}" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#3C4A5C;strokeColor=#3C4A5C;fontColor=#FFFFFF;fontSize=12;fontStyle=1;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="500" y="110" width="400" height="26" as="geometry" />
        </mxCell>
        <mxCell id="v6" value="PK momentId          string  uuid4[:16]&#10;FK jobId, ownerUid&#10;   momentType, category, label   string&#10;   startSec, endSec, peakSec     float  match-absolute&#10;   confidence, excitement        float  0-1&#10;   highlightScore                float  type prior x conf x excite&#10;   description, summary          string&#10;   evidence            array&lt;string&gt;&#10;   scoreboard          string | null&#10;   isGoal              bool&#10;   actionResult, participant,&#10;     participantRole, actionTeam string&#10;   team1, team2        string   consensus (handball only)&#10;   scoreTeam1, scoreTeam2  int | null   null = unreadable, not 0&#10;   executionDetails, harmonyIndex string  equestrian only&#10;   thumbUri            string   gs:// PNG at the peak frame&#10;   segmentIndexes      array&lt;int&gt;   &gt;1 = merged across windows&#10;   embedding           vector&lt;768&gt;  whole ActionPlay, not just&#10;                                    the description&#10;   createdAt           timestamp" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4A4A4A;verticalAlign=top;align=left;fontSize=11;spacing=4;fontFamily=Courier New;" vertex="1" parent="1">
          <mxGeometry x="500" y="136" width="400" height="370" as="geometry" />
        </mxCell>
        <mxCell id="v7" value="jobs/{jobId}/clips/{clipId}" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#3C4A5C;strokeColor=#3C4A5C;fontColor=#FFFFFF;fontSize=12;fontStyle=1;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="500" y="536" width="400" height="26" as="geometry" />
        </mxCell>
        <mxCell id="v8" value="PK clipId            string&#10;FK jobId, ownerUid, momentId&#10;   startSec, endSec, durationSec  float&#10;   aspect              string   9:16 | 1:1&#10;   platforms           array&lt;string&gt;&#10;   hookText, title     string&#10;   captions            map&lt;platform, string&gt;&#10;   hashtags            array&lt;string&gt;&#10;   score, rationale&#10;   status              string   suggested&#10;   renderUri, thumbnailUri  string | null&#10;   createdAt, updatedAt     timestamp" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4A4A4A;verticalAlign=top;align=left;fontSize=11;spacing=4;fontFamily=Courier New;" vertex="1" parent="1">
          <mxGeometry x="500" y="562" width="400" height="226" as="geometry" />
        </mxCell>
        <mxCell id="v9" value="jobs/{jobId}/events/{eventId}" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#3C4A5C;strokeColor=#3C4A5C;fontColor=#FFFFFF;fontSize=12;fontStyle=1;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="500" y="818" width="400" height="26" as="geometry" />
        </mxCell>
        <mxCell id="v10" value="PK eventId           string   auto-id&#10;FK jobId&#10;   ts                 timestamp&#10;   stage               string&#10;   level                string   info | warning | error&#10;   message              string&#10;   data                 map     stage-specific extras" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4A4A4A;verticalAlign=top;align=left;fontSize=11;spacing=4;fontFamily=Courier New;" vertex="1" parent="1">
          <mxGeometry x="500" y="844" width="400" height="136" as="geometry" />
        </mxCell>
        <mxCell id="v11" value="games/{jobId}  (top level, keyed by jobId)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#6B4F8F;strokeColor=#6B4F8F;fontColor=#FFFFFF;fontSize=12;fontStyle=1;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="960" y="110" width="420" height="26" as="geometry" />
        </mxCell>
        <mxCell id="v12" value="PK jobId             string   == jobs/{jobId}&#10;   ownerUid          string&#10;   title, sport      string&#10;   discipline        string   label, not code; equestrian&#10;   disciplineConfidence  float&#10;   homeTeam, awayTeam    string   empty when teams are not&#10;                                 constant across the job&#10;   competition, venue    string&#10;   finalScore        string   last legible scoreline, never&#10;                              a count of detected goals&#10;   eventOutcome      string&#10;   sentiment, mood, summary   string  model judgement&#10;   momentCount, highlightCount  int&#10;   grounded          bool&#10;   groundedCompetition, groundedVenue,&#10;     groundedHomeTeam, groundedAwayTeam  string&#10;   matchDate         string&#10;   groundingSources  array&lt;{title, uri}&gt;&#10;   embedding         vector&lt;768&gt;&#10;   updatedAt         timestamp" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4A4A4A;verticalAlign=top;align=left;fontSize=11;spacing=4;fontFamily=Courier New;" vertex="1" parent="1">
          <mxGeometry x="960" y="136" width="420" height="370" as="geometry" />
        </mxCell>
        <mxCell id="v13" value="jobId is a foreign key by convention, not by a Firestore constraint:&#10;there is no cross-collection reference type. games/{jobId} shares its&#10;document id with jobs/{jobId} instead of storing jobId as a field&#10;and querying for it." style="shape=note;whiteSpace=wrap;html=1;size=16;fillColor=#FFFCF0;strokeColor=#D6B656;align=left;verticalAlign=top;spacing=8;fontSize=10;fontColor=#6B5A20;" vertex="1" parent="1">
          <mxGeometry x="960" y="526" width="420" height="80" as="geometry" />
        </mxCell>
        <mxCell id="v14" value="Firestore indexes (deploy/terraform/firestore.tf)" style="text;html=1;align=left;verticalAlign=middle;fontSize=16;fontStyle=1;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="60" y="1020" width="1660" height="30" as="geometry" />
        </mxCell>
        <mxCell id="v15" value="jobs_by_owner_recent&#10;jobs&#10;ownerUid ASC, createdAt DESC&#10;list_jobs's old shape. ownerUid is accepted and ignored now — kept so a&#10;caller that still passes one is not silently answered with a filtered list." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#EAF2FB;strokeColor=#6C8EBF;fontSize=10;align=left;verticalAlign=top;spacing=6;fontFamily=Courier New;" vertex="1" parent="1">
          <mxGeometry x="60" y="1060" width="520" height="92" as="geometry" />
        </mxCell>
        <mxCell id="v16" value="moments_by_score&#10;moments (COLLECTION_GROUP)&#10;jobId ASC, highlightScore DESC&#10;list_moments: every moment of one job, ranked.&#10;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#EAF2FB;strokeColor=#6C8EBF;fontSize=10;align=left;verticalAlign=top;spacing=6;fontFamily=Courier New;" vertex="1" parent="1">
          <mxGeometry x="600" y="1060" width="520" height="92" as="geometry" />
        </mxCell>
        <mxCell id="v17" value="clips_by_score&#10;clips (COLLECTION_GROUP)&#10;jobId ASC, score DESC&#10;list_clips, same shape as moments_by_score.&#10;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#EAF2FB;strokeColor=#6C8EBF;fontSize=10;align=left;verticalAlign=top;spacing=6;fontFamily=Courier New;" vertex="1" parent="1">
          <mxGeometry x="1140" y="1060" width="520" height="92" as="geometry" />
        </mxCell>
        <mxCell id="v18" value="events_by_ts&#10;events (COLLECTION_GROUP)&#10;jobId ASC, ts DESC&#10;the activity feed, newest first.&#10;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#EAF2FB;strokeColor=#6C8EBF;fontSize=10;align=left;verticalAlign=top;spacing=6;fontFamily=Courier New;" vertex="1" parent="1">
          <mxGeometry x="60" y="1172" width="520" height="92" as="geometry" />
        </mxCell>
        <mxCell id="v19" value="moments_knn&#10;moments (COLLECTION_GROUP)&#10;ownerUid ASC + embedding&lt;768&gt;&#10;owner-scoped search. Left in place after the ownership change —&#10;deleting a vector index is the one operation this repo warns against." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#EAF2FB;strokeColor=#6C8EBF;fontSize=10;align=left;verticalAlign=top;spacing=6;fontFamily=Courier New;" vertex="1" parent="1">
          <mxGeometry x="600" y="1172" width="520" height="92" as="geometry" />
        </mxCell>
        <mxCell id="v20" value="moments_knn_all&#10;moments (COLLECTION_GROUP)&#10;embedding&lt;768&gt; only&#10;unscoped search: what knn_search_moments actually queries now.&#10;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#EAF2FB;strokeColor=#6C8EBF;fontSize=10;align=left;verticalAlign=top;spacing=6;fontFamily=Courier New;" vertex="1" parent="1">
          <mxGeometry x="1140" y="1172" width="520" height="92" as="geometry" />
        </mxCell>
        <mxCell id="v21" value="games_knn&#10;games (COLLECTION)&#10;ownerUid ASC + embedding&lt;768&gt;&#10;same reasoning as moments_knn.&#10;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#EAF2FB;strokeColor=#6C8EBF;fontSize=10;align=left;verticalAlign=top;spacing=6;fontFamily=Courier New;" vertex="1" parent="1">
          <mxGeometry x="60" y="1284" width="520" height="92" as="geometry" />
        </mxCell>
        <mxCell id="v22" value="games_knn_all&#10;games (COLLECTION)&#10;embedding&lt;768&gt; only&#10;what knn_search_games actually queries.&#10;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#EAF2FB;strokeColor=#6C8EBF;fontSize=10;align=left;verticalAlign=top;spacing=6;fontFamily=Courier New;" vertex="1" parent="1">
          <mxGeometry x="600" y="1284" width="520" height="92" as="geometry" />
        </mxCell>
        <mxCell id="v23" value="clips_knn&#10;clips (COLLECTION_GROUP)&#10;ownerUid ASC + embedding&lt;768&gt;&#10;reserved; no clip-level semantic search ships yet.&#10;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#EAF2FB;strokeColor=#6C8EBF;fontSize=10;align=left;verticalAlign=top;spacing=6;fontFamily=Courier New;" vertex="1" parent="1">
          <mxGeometry x="1140" y="1284" width="520" height="92" as="geometry" />
        </mxCell>
        <mxCell id="v24" value="An inequality filter forces the first order_by to be that same field — Firestore will&#10;not run the query otherwise, and it fails on a live read with a link to create an index.&#10;list_action_plays and list_jobs order by the plain field (startSec, createdAt) and apply&#10;any threshold in Python instead, which is what keeps them off a composite index.&#10;&#10;A vector index with an equality prefix (ownerUid) only serves queries carrying that&#10;equality — dropping the owner filter needed the *_knn_all indexes rather than reusing&#10;the scoped ones. Every embedding is 768 dimensions to match gemini-embedding-001 exactly;&#10;a mismatch fails queries at read time; a mismatched write fails silently until then.&#10;&#10;Firestore vector indexes replace themselves on every apply: the provider appends __name__&#10;to what it creates, so the remote object never matches the declared fields and every apply&#10;wants to force-replace it. ignore_changes = [fields] on every *_knn* resource is what stops&#10;that loop; changing a vector definition means deleting the index and re-applying, never&#10;editing in place." style="shape=note;whiteSpace=wrap;html=1;size=16;fillColor=#FFFCF0;strokeColor=#D6B656;align=left;verticalAlign=top;spacing=8;fontSize=10;fontColor=#6B5A20;" vertex="1" parent="1">
          <mxGeometry x="60" y="1416" width="1660" height="190" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
