<mxfile host="app.diagrams.net" agent="Sportscut" type="device">
  <diagram id="components" name="Components">
    <mxGraphModel dx="1600" dy="1200" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="1500" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="v1" value="Sportscut — components" style="text;html=1;align=left;verticalAlign=middle;fontSize=20;fontStyle=1;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="60" y="20" width="600" height="30" as="geometry" />
        </mxCell>
        <mxCell id="v2" value="Agentic short-form clipping for sport. One hostname, four Cloud Run services,&#10;one Agent Runtime engine." style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#7A7A7A;" vertex="1" parent="1">
          <mxGeometry x="60" y="48" width="700" height="30" as="geometry" />
        </mxCell>
        <mxCell id="v3" value="Browser" style="rounded=0;whiteSpace=wrap;html=1;dashed=1;dashPattern=8 8;fillColor=none;strokeColor=#9AA3AD;verticalAlign=top;align=left;spacingLeft=14;spacingTop=8;fontSize=14;fontStyle=1;fontColor=#5A6570;" vertex="1" parent="1">
          <mxGeometry x="60" y="96" width="1420" height="170" as="geometry" />
        </mxCell>
        <mxCell id="v4" value="Editor SPA&#10;ES modules, no bundler&#10;app.js · cards.js · search.js" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="84" y="140" width="250" height="104" as="geometry" />
        </mxCell>
        <mxCell id="v5" value="hls.js player&#10;seeks to the in point,&#10;stops at the out point" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="354" y="140" width="190" height="104" as="geometry" />
        </mxCell>
        <mxCell id="v6" value="Firebase SDK&#10;ID token, refreshed at 45 min&#10;live Firestore listeners" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="564" y="140" width="230" height="104" as="geometry" />
        </mxCell>
        <mxCell id="v7" value="Identity Platform&#10;email/password&#10;accounts provisioned by hand" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=11;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="814" y="140" width="200" height="104" as="geometry" />
        </mxCell>
        <mxCell id="v8" value="No self-service sign-up, and no&#10;federated button unless a provider&#10;is actually configured — the editor&#10;never offers a method that can&#10;only fail." style="shape=note;whiteSpace=wrap;html=1;size=16;fillColor=#FFFCF0;strokeColor=#D6B656;align=left;verticalAlign=top;spacing=8;fontSize=10;fontColor=#6B5A20;" vertex="1" parent="1">
          <mxGeometry x="1044" y="130" width="260" height="124" as="geometry" />
        </mxCell>
        <mxCell id="v9" value="Google Cloud load balancer — one hostname, so everything is same-origin" style="rounded=0;whiteSpace=wrap;html=1;dashed=1;dashPattern=8 8;fillColor=none;strokeColor=#9AA3AD;verticalAlign=top;align=left;spacingLeft=14;spacingTop=8;fontSize=14;fontStyle=1;fontColor=#5A6570;" vertex="1" parent="1">
          <mxGeometry x="60" y="306" width="1420" height="168" as="geometry" />
        </mxCell>
        <mxCell id="v10" value="Global external HTTPS LB&#10;managed certificate" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontSize=11;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="84" y="356" width="210" height="96" as="geometry" />
        </mxCell>
        <mxCell id="v11" value="/&#10;→ web" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontSize=11;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="324" y="356" width="130" height="96" as="geometry" />
        </mxCell>
        <mxCell id="v12" value="/api/*&#10;→ api" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontSize=11;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="484" y="356" width="130" height="96" as="geometry" />
        </mxCell>
        <mxCell id="v13" value="/jobs/*&#10;→ HLS bucket&#10;Cloud CDN, signed cookie" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontSize=11;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="644" y="356" width="210" height="96" as="geometry" />
        </mxCell>
        <mxCell id="v14" value="The same hostname is load-bearing: the CDN cookie is same-origin because of it.&#10;On separate *.run.app hosts it could not be — run.app is on the Public Suffix List.&#10;&#10;Reach is controlled by ingress. Both public services accept traffic only from the&#10;balancer, so their run.app URLs are dead ends." style="shape=note;whiteSpace=wrap;html=1;size=16;fillColor=#FFFCF0;strokeColor=#D6B656;align=left;verticalAlign=top;spacing=8;fontSize=10;fontColor=#6B5A20;" vertex="1" parent="1">
          <mxGeometry x="884" y="346" width="420" height="118" as="geometry" />
        </mxCell>
        <mxCell id="v15" value="Cloud Run" style="rounded=0;whiteSpace=wrap;html=1;dashed=1;dashPattern=8 8;fillColor=none;strokeColor=#9AA3AD;verticalAlign=top;align=left;spacingLeft=14;spacingTop=8;fontSize=14;fontStyle=1;fontColor=#5A6570;" vertex="1" parent="1">
          <mxGeometry x="60" y="514" width="700" height="356" as="geometry" />
        </mxCell>
        <mxCell id="v16" value="web&#10;nginx, serves src/ as written&#10;no-cache revalidation" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=11;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="84" y="562" width="300" height="76" as="geometry" />
        </mxCell>
        <mxCell id="v17" value="api — FastAPI&#10;verifies the ID token · signs upload and&#10;thumbnail URLs · mints the CDN cookie&#10;proxies the agent's SSE stream" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=11;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="84" y="654" width="300" height="100" as="geometry" />
        </mxCell>
        <mxCell id="v18" value="mcp-catalog&#10;Firestore · embeddings&#10;KNN + Gemini rerank" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=11;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="404" y="562" width="330" height="76" as="geometry" />
        </mxCell>
        <mxCell id="v19" value="mcp-media&#10;ffmpeg: probe, cut, keyframe still, reframe&#10;drives Transcoder API · concurrency 1,&#10;because the writable filesystem is memory" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=11;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="404" y="654" width="330" height="100" as="geometry" />
        </mxCell>
        <mxCell id="v20" value="The MCP servers are ingress-ALL rather than internal-only: Cloud Run services calling&#10;each other egress over the public internet, so internal-only would 404 the very callers&#10;they exist for. They stay private through IAM — every call carries an OIDC token." style="shape=note;whiteSpace=wrap;html=1;size=16;fillColor=#FFFCF0;strokeColor=#D6B656;align=left;verticalAlign=top;spacing=8;fontSize=10;fontColor=#6B5A20;" vertex="1" parent="1">
          <mxGeometry x="84" y="774" width="650" height="76" as="geometry" />
        </mxCell>
        <mxCell id="v21" value="Vertex AI Agent Runtime — one engine, resolved by display name" style="rounded=0;whiteSpace=wrap;html=1;dashed=1;dashPattern=8 8;fillColor=none;strokeColor=#9AA3AD;verticalAlign=top;align=left;spacingLeft=14;spacingTop=8;fontSize=14;fontStyle=1;fontColor=#5A6570;" vertex="1" parent="1">
          <mxGeometry x="800" y="514" width="680" height="356" as="geometry" />
        </mxCell>
        <mxCell id="v22" value="sprtz_producer  (root agent)&#10;list_jobs · get_job_summary · find_games&#10;search_moments · list_action_plays&#10;prepare_playback · generate_thumbnails&#10;re-analyse · cancel · delete" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;fontSize=11;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="824" y="562" width="300" height="124" as="geometry" />
        </mxCell>
        <mxCell id="v23" value="The tool list is bound at import&#10;time: whatever is unset while&#10;deploy.py imports the module is&#10;missing from the packaged agent&#10;for good.&#10;&#10;MCP toolsets need a header_provider,&#10;not static headers — a token would&#10;expire an hour into the deployment." style="shape=note;whiteSpace=wrap;html=1;size=16;fillColor=#FFFCF0;strokeColor=#D6B656;align=left;verticalAlign=top;spacing=8;fontSize=10;fontColor=#6B5A20;" vertex="1" parent="1">
          <mxGeometry x="1144" y="552" width="310" height="144" as="geometry" />
        </mxCell>
        <mxCell id="v24" value="analysis_pipeline  (SequentialAgent)" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;fontSize=11;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="824" y="706" width="630" height="34" as="geometry" />
        </mxCell>
        <mxCell id="v25" value="ingest" style="rounded=1;arcSize=24;whiteSpace=wrap;html=1;fillColor=#FFF4E6;strokeColor=#D79B00;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="826" y="754" width="98" height="44" as="geometry" />
        </mxCell>
        <mxCell id="v26" value="transcode" style="rounded=1;arcSize=24;whiteSpace=wrap;html=1;fillColor=#FFF4E6;strokeColor=#D79B00;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="930" y="754" width="98" height="44" as="geometry" />
        </mxCell>
        <mxCell id="v27" value="analysis" style="rounded=1;arcSize=24;whiteSpace=wrap;html=1;fillColor=#FFF4E6;strokeColor=#D79B00;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="1034" y="754" width="98" height="44" as="geometry" />
        </mxCell>
        <mxCell id="v28" value="clips" style="rounded=1;arcSize=24;whiteSpace=wrap;html=1;fillColor=#FFF4E6;strokeColor=#D79B00;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="1138" y="754" width="98" height="44" as="geometry" />
        </mxCell>
        <mxCell id="v29" value="captions" style="rounded=1;arcSize=24;whiteSpace=wrap;html=1;fillColor=#FFF4E6;strokeColor=#D79B00;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="1242" y="754" width="98" height="44" as="geometry" />
        </mxCell>
        <mxCell id="v30" value="publish" style="rounded=1;arcSize=24;whiteSpace=wrap;html=1;fillColor=#FFF4E6;strokeColor=#D79B00;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="1346" y="754" width="98" height="44" as="geometry" />
        </mxCell>
        <mxCell id="v31" value="Every stage is wrapped so a death is recorded: a container killed mid-response&#10;otherwise leaves the job reading as working for ever." style="shape=note;whiteSpace=wrap;html=1;size=16;fillColor=#FFFCF0;strokeColor=#D6B656;align=left;verticalAlign=top;spacing=8;fontSize=10;fontColor=#6B5A20;" vertex="1" parent="1">
          <mxGeometry x="824" y="812" width="630" height="44" as="geometry" />
        </mxCell>
        <mxCell id="v32" value="Data" style="rounded=0;whiteSpace=wrap;html=1;dashed=1;dashPattern=8 8;fillColor=none;strokeColor=#9AA3AD;verticalAlign=top;align=left;spacingLeft=14;spacingTop=8;fontSize=14;fontStyle=1;fontColor=#5A6570;" vertex="1" parent="1">
          <mxGeometry x="60" y="910" width="700" height="330" as="geometry" />
        </mxCell>
        <mxCell id="v33" value="GCS uploads&#10;the source video" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=11;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="84" y="958" width="130" height="108" as="geometry" />
        </mxCell>
        <mxCell id="v34" value="GCS media&#10;analysis segments,&#10;clip renders,&#10;moment stills" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=11;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="224" y="958" width="140" height="108" as="geometry" />
        </mxCell>
        <mxCell id="v35" value="GCS hls&#10;480p package,&#10;poster" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=11;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="374" y="958" width="120" height="108" as="geometry" />
        </mxCell>
        <mxCell id="v36" value="Firestore&#10;jobs · moments · clips · events&#10;games (top level, own index)&#10;moments_knn_all · games_knn_all" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=11;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="514" y="958" width="220" height="108" as="geometry" />
        </mxCell>
        <mxCell id="v37" value="Secret Manager — CDN signing key" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=11;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="84" y="1086" width="410" height="44" as="geometry" />
        </mxCell>
        <mxCell id="v38" value="Firestore rules require request.auth. Jobs are shared across the desk: any signed-in&#10;user reads and deletes any job, and ownerUid is provenance rather than a gate." style="shape=note;whiteSpace=wrap;html=1;size=16;fillColor=#FFFCF0;strokeColor=#D6B656;align=left;verticalAlign=top;spacing=8;fontSize=10;fontColor=#6B5A20;" vertex="1" parent="1">
          <mxGeometry x="84" y="1146" width="650" height="60" as="geometry" />
        </mxCell>
        <mxCell id="v39" value="Google APIs" style="rounded=0;whiteSpace=wrap;html=1;dashed=1;dashPattern=8 8;fillColor=none;strokeColor=#9AA3AD;verticalAlign=top;align=left;spacingLeft=14;spacingTop=8;fontSize=14;fontStyle=1;fontColor=#5A6570;" vertex="1" parent="1">
          <mxGeometry x="800" y="910" width="680" height="330" as="geometry" />
        </mxCell>
        <mxCell id="v40" value="Gemini 2.5 Flash&#10;segment analysis at 1 fps,&#10;rerank, game judgement" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=11;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="824" y="958" width="200" height="108" as="geometry" />
        </mxCell>
        <mxCell id="v41" value="gemini-embedding-001&#10;768 dimensions — must equal&#10;the Firestore index width" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=11;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="1034" y="958" width="200" height="108" as="geometry" />
        </mxCell>
        <mxCell id="v42" value="Google Search&#10;grounding&#10;once per match" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=11;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="1244" y="958" width="110" height="108" as="geometry" />
        </mxCell>
        <mxCell id="v43" value="Transcoder&#10;API&#10;GCS → GCS" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=11;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="1364" y="958" width="92" height="108" as="geometry" />
        </mxCell>
        <mxCell id="v44" value="IAM signBlob — Cloud Run has no private key, so every signed URL goes through it" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=11;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="824" y="1086" width="632" height="44" as="geometry" />
        </mxCell>
        <mxCell id="v45" value="Transcoder's own service agent needs the bucket grants, not the media service account —&#10;and both failures surface minutes into an encode rather than when the job is created." style="shape=note;whiteSpace=wrap;html=1;size=16;fillColor=#FFFCF0;strokeColor=#D6B656;align=left;verticalAlign=top;spacing=8;fontSize=10;fontColor=#6B5A20;" vertex="1" parent="1">
          <mxGeometry x="824" y="1146" width="632" height="60" as="geometry" />
        </mxCell>
        <mxCell id="v46" value="Delivery — merging to main is a deploy" style="rounded=0;whiteSpace=wrap;html=1;dashed=1;dashPattern=8 8;fillColor=none;strokeColor=#9AA3AD;verticalAlign=top;align=left;spacingLeft=14;spacingTop=8;fontSize=14;fontStyle=1;fontColor=#5A6570;" vertex="1" parent="1">
          <mxGeometry x="60" y="1276" width="1420" height="150" as="geometry" />
        </mxCell>
        <mxCell id="v47" value="GitHub&#10;main" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#8C8C8C;fontSize=11;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="84" y="1326" width="110" height="76" as="geometry" />
        </mxCell>
        <mxCell id="v48" value="Cloud Build&#10;pytest · ruff · check.mjs · node --test&#10;terraform apply" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#8C8C8C;fontSize=11;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="224" y="1326" width="260" height="76" as="geometry" />
        </mxCell>
        <mxCell id="v49" value="Artifact Registry&#10;web · api · mcp images" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#8C8C8C;fontSize=11;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="514" y="1326" width="190" height="76" as="geometry" />
        </mxCell>
        <mxCell id="v50" value="deploy.py&#10;creates or updates the engine&#10;by display name" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#8C8C8C;fontSize=11;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="734" y="1326" width="240" height="76" as="geometry" />
        </mxCell>
        <mxCell id="v51" value="Terraform owns everything except the Agent Runtime engine. The provider creates one with&#10;spec.deployment_source while the SDK updates it with spec.package_spec, and the API refuses&#10;to move an engine from one to the other — so the script owns that lifecycle instead." style="shape=note;whiteSpace=wrap;html=1;size=16;fillColor=#FFFCF0;strokeColor=#D6B656;align=left;verticalAlign=top;spacing=8;fontSize=10;fontColor=#6B5A20;" vertex="1" parent="1">
          <mxGeometry x="1004" y="1316" width="452" height="96" as="geometry" />
        </mxCell>
        <mxCell id="e52" value="HTTPS" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jumpStyle=arc;jumpSize=10;fontSize=10;labelBackgroundColor=#FFFFFF;endArrow=blockThin;endFill=1;strokeWidth=1.4;strokeColor=#6C8EBF;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="v4" target="v10">
