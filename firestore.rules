rules_version = '2';

// The SPA talks to Firestore directly for realtime sync, so these rules are the
// only client-side boundary. Everything is read-only from the client — all
// writes go through the agents via the mcp-catalog server, which uses Admin
// credentials and bypasses these rules.
//
// Reads are shared: any signed-in user sees every job. This is a deliberate
// product decision, not an oversight. Accounts are provisioned by hand in
// Identity Platform and everyone with one is on the same desk, so a match
// uploaded by a colleague is a match this desk is working on. Authentication
// still gates everything — the boundary is "signed in", not "owns it".
//
// ownerUid is still written on every job, as provenance rather than as a gate:
// it says who uploaded a match, which is worth knowing precisely because
// anyone can now act on it.
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null && request.auth.uid != null;
    }

    function jobExists(jobId) {
      return isSignedIn() && exists(/databases/$(database)/documents/jobs/$(jobId));
    }

    match /users/{uid} {
      allow read: if isSignedIn() && request.auth.uid == uid;
      // A user may edit their own display preferences and nothing else.
      allow update: if isSignedIn()
        && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['displayName', 'defaultPlatforms', 'updatedAt']);
      allow create, delete: if false;
    }

    match /jobs/{jobId} {
      allow read: if isSignedIn();
      // Creation and status transitions are the API's and the agents' job.
      allow write: if false;

      match /events/{eventId} {
        allow read: if jobExists(jobId);
        allow write: if false;
      }

      match /moments/{momentId} {
        allow read: if jobExists(jobId);
        allow write: if false;
      }

      match /clips/{clipId} {
        allow read: if jobExists(jobId);
        allow write: if false;
      }

      match /segments/{segmentId} {
        allow read: if jobExists(jobId);
        allow write: if false;
      }
    }

    // Game records are top-level rather than a subcollection of the job, so
    // they need their own rule: the catch-all at the bottom denies anything not
    // named here, and the editor reads this collection directly for realtime
    // game details. Owner-scoped on the document's own field, since there is no
    // parent job path to inherit from.
    match /games/{jobId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    match /renders/{renderId} {
      allow read: if isSignedIn() && resource.data.requestedBy == request.auth.uid;
      allow write: if false;
    }

    // Anything not matched above is denied.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
